# Copy to .env for local Node, or edit these in docker-compose before deploying.
# Docker Compose reads ADMIN_PASSWORD from the environment if you export it.

ADMIN_PASSWORD=changeme
BOARD_NAME=QuorDiscuss
BOARD_TAGLINE=What should we build next?
BOARD_DESCRIPTION=Suggest ideas, vote, and follow what ships.
# Public URL of this board, used for canonical links, the sitemap, and RSS.
# APP_URL=https://feedback.example.com
# Link the footer "Powered by QuorDiscuss" text to your GitHub repository.
# PROJECT_URL=https://github.com/YOUR_GITHUB_USER/quordiscuss
PORT=8080
DATA_DIR=./data
TRUST_PROXY=0
